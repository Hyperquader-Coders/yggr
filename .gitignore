# Build artefacts — every one is regenerated by the Makefile, and the flatpak
# trees are large (build-flatpak ~200M, .flatpak-builder ~1G).
build/
out/
build-flatpak/
.flatpak-builder/
repo/
dist/
*.o

# Compiled catalogue: `make mo` regenerates it from po/de.po, which IS tracked.
data/locale/*/LC_MESSAGES/*.mo

# Agent files are local and are not shared.
.claude/
.mcp.json

# Claude config dirs, if a session ever materialises one here.
.claude-amber/
.credentials.json
